# Chave da sua conta Resend (a mesma usada nos outros projetos)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Para qual e-mail os leads serão enviados (CRM interno)
LEAD_TO_EMAIL=contato@agilizouseguros.com.br

# Remetente — domínio precisa estar verificado no Resend
FROM_EMAIL=Agilizou Seguros <contato@agilizouseguros.com.br>

# Origem permitida no CORS (use seu domínio de produção)
ALLOWED_ORIGIN=https://agilizouseguros.com.br

# Porta interna do Node (Nginx faz proxy_pass para ela)
PORT=3001
